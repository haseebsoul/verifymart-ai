NODE_ENV=development
PORT=8000
DATABASE_PATH=./data/verifymart.sqlite
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_ACCESS_TTL=15m
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
DEMO_PASSWORD=VerifyMart-Demo-2026
VITE_API_URL=http://localhost:8000/api

# Atlas migration is opt-in until the staging credentials and audit DB role exist.
# Never commit real URI/password values.
MONGODB_DB_NAME=verifymart_dev
MONGODB_APP_NAME=VerifyMart-Dev
# MONGODB_URI=mongodb+srv://<DEV_USER>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
# MONGODB_AUDIT_URI=mongodb+srv://<AUDIT_USER>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
# MONGODB_MIGRATION_URI=<ONE_TIME_MIGRATION_URI>
# MONGODB_AUDIT_MIGRATION_URI=<INSERT_ONLY_AUDIT_MIGRATION_URI>
