NODE_ENV=development
PORT=5000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_ACCESS_TTL=15m
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=/api

# Atlas is the normal application runtime. Configure development credentials outside Git.
# Never commit real URI/password values.
MONGODB_DB_NAME=verifymart_dev
MONGODB_APP_NAME=VerifyMart-Dev
MONGODB_URI=mongodb+srv://<DEV_USER>:<URL_ENCODED_PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
# Insert-only on auditLog. No find/update/remove privileges.
MONGODB_AUDIT_URI=mongodb+srv://<AUDIT_WRITER_USER>:<URL_ENCODED_PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
# Read-only on auditLog (find only); used by Operator/Admin audit review.
MONGODB_AUDIT_READ_URI=mongodb+srv://<AUDIT_READER_USER>:<URL_ENCODED_PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
# Admin self-registration is invitation-gated; never put a real key in Git.
# ADMIN_INVITE_KEY=<LONG_RANDOM_ADMIN_INVITE_KEY>
# Optional JSON map for inventory_manager/operator registration invitations.
# ROLE_INVITE_KEYS={"inventory_manager":"<KEY>","operator":"<KEY>"}
# DEMO_PASSWORD=<SET_ONLY_WHEN_YOU_EXPLICITLY_WANT_DEMO_ACCOUNTS>
# One-off migration/admin identity only. Full administrative privileges are
# limited to the selected dev/staging database; never configure in API runtime.
# Set both names to the same migration identity because the CLI handles
# operational collections and auditLog in separate stages.
# MONGODB_MIGRATION_URI=<ONE_TIME_DEVELOPMENT_MIGRATION_URI>
# MONGODB_AUDIT_MIGRATION_URI=<SAME_ONE_TIME_MIGRATION_IDENTITY_URI>
#
# DEMO_PASSWORD alone is not sufficient to turn on demo login shortcuts.
# Explicitly set ENABLE_DEMO_AUTH=true only for a local development session.
ENABLE_DEMO_AUTH=false
